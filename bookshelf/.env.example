# Local SQLite file — zero setup. Switch to a Postgres URL for Vercel
# (see README "Deploying to Vercel").
DATABASE_URL="file:./dev.db"

# The single admin password used to log in and add/edit/delete books.
# Pick a real value — this gates write access to your shelf.
ADMIN_PASSWORD="change-me"

# Any long random string, used to sign the login session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-too"

# Optional. Only needed in production so cover uploads persist.
# Create a Blob store in the Vercel dashboard (Storage tab) and it will
# add this automatically to your project's env vars.
# BLOB_READ_WRITE_TOKEN=""
