generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Book {
  id            String   @id @default(cuid())
  title         String
  author        String?
  type          String // Fiction | Non Fiction | Biography | Autobiography | ...
  genre         String // Sci-Fi | Romance | Drama | Fantasy | ...
  status        String // READING | RECOMMENDED | READ
  rating        Float?
  coverUrl      String?
  review        String?
  publishedYear Int?     // <-- Publication year field
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([genre])
  @@index([status])
}