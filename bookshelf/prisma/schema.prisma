// Prisma schema for My Bookshelf
//
// Ships pointed at SQLite so the prototype runs locally with zero cloud
// accounts. For Vercel you MUST switch the datasource to Postgres — see
// README.md "Deploying to Vercel" for the two-line change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// READING     -> currently reading (sheet's "r")
// RECOMMENDED -> on the list / not started yet (sheet's "Rosh (...)")
// READ        -> finished, has a rating (sheet's numeric score)
model Book {
  id        String   @id @default(cuid())
  title     String
  author    String?
  type      String // Fiction | Non Fiction | Biography | Autobiography | ...
  genre     String // Sci-Fi | Romance | Drama | Fantasy | ...
  status    String // READING | RECOMMENDED | READ
  rating    Float?
  coverUrl  String?
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([genre])
  @@index([status])
}
