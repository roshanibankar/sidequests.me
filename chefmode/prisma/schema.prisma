datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Recipe {
  id          String   @id @default(cuid())
  title       String
  category    String
  prepTime    String
  servings    String
  notes       String?
  ingredients String[]
  steps       String[]
  createdAt   DateTime @default(now())
}